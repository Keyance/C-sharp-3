@page "/createToDoItem"
@using ToDoList.Domain.Models
@using ToDoList.Frontend.Clients
@using ToDoList.Frontend.Models

@inject IToDoItemsClient toDoItemsClient
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<EditForm Model="ToDoItemModel" FormName="CreateToDoItem" OnSubmit="Create">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label for="Name" class="form-label">Name</label>
        <InputText id="Name" class="form-control w-25" @bind-Value="ToDoItemModel.Name" />
        <ValidationMessage For="() => ToDoItemModel.Name" />
    </div>
    <div class="mb-3">
        <label for="Description" class="form-label">Description</label>
        <InputText id="Description" class="form-control w-25" @bind-Value="ToDoItemModel.Description" />
    </div>

    <div class="mb-3">
        <label for="Kategory" class="form-label">Kategory</label>
        <InputText id="Kategory" class="form-control w-25" @bind-Value="ToDoItemModel.Kategory" />
    </div>
    
    <div class="mb-3">
        <label for="IsCompleted" class="form-check-label">IsCompleted:</label>
    </div>

    <div class="mb-3">
        <InputCheckbox id="IsCompleted" @bind-Value="ToDoItemModel.IsCompleted" />
    </div>


    <button type="submit">Odeslat</button>
</EditForm>

@code {

    public ToDoItemView ToDoItemModel { get; set; }

    protected override void OnInitialized()
    {
        ToDoItemModel = new ToDoItemView();
    }
    public async Task Create()
    {
        await toDoItemsClient.CreateItemAsync(ToDoItemModel);
        NavigationManager.NavigateTo("/");
    }


}
